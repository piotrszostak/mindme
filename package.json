{
  "name": "mindmap",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "serve": "serve www -l 3000",
    "android": "cap sync android && cap open android",
    "tauri": "tauri build --bundles appimage",
    "test": "playwright test",
    "format": "prettier --write www types tests playwright.config.js tsconfig.json tsconfig.sw.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "verify": "npm run check && prettier --check www types tests playwright.config.js && playwright test && npm run perf",
    "perf": "PERF=1 playwright test tests/perf.spec.js --workers=1",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@capacitor/cli": "^6",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^6",
    "@capacitor/core": "^6"
  },
  "license": "MIT"
}
